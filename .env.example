# Criadas automaticamente pela Vercel quando você conecta um banco Postgres
# (aba "Storage" do projeto na Vercel -> Create Database -> Postgres/Neon).
# Para rodar localmente, rode `vercel env pull .env.local` depois de conectar.
POSTGRES_URL=
DATABASE_URL=

# Gere uma string aleatória (ex: `openssl rand -hex 32`) e use o mesmo valor
# em produção. Usada para assinar o cookie de sessão do admin.
SESSION_SECRET=

# Login do painel. Se não definidas, o padrão é admin / admin — troque antes
# de usar com a equipe.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- PIX (cobrança) -----------------------------------------------------
# Chave Pix que vai receber as cobranças (só números, sem pontuação).
PIX_KEY=06914540000167

# Nome do titular da chave Pix, exatamente como está no banco (sem acento,
# até 25 caracteres — o sistema trunca e remove acento automaticamente,
# mas o resultado fica melhor se você já mandar algo próximo do limite).
PIX_MERCHANT_NAME=VOLTGO

# Cidade do titular da chave Pix (sem acento, até 15 caracteres).
PIX_MERCHANT_CITY=SAO PAULO

# --- Regras de cobrança --------------------------------------------------
# Franquia mensal de km e valor do km excedente (em reais, use ponto decimal).
# Obs.: o pedido original mencionava R$ 0,75/km, mas o modelo de contrato
# enviado (cláusula 2.5) usa R$ 0,70/km — deixei 0.70 como padrão por ser o
# valor do documento assinado. Troque aqui se 0.75 estiver correto; o mesmo
# valor é usado tanto na cobrança quanto no texto do contrato.
KM_FRANQUIA_MENSAL=8000
VALOR_KM_EXCEDENTE=0.70

# Franquia do seguro em caso de sinistro (cláusula 3.2 do contrato).
FRANQUIA_SINISTRO_VALOR=8845

# --- Fotos do hodômetro (envio semanal pelo motorista) -------------------
# Criada automaticamente pela Vercel quando você conecta um Blob store
# (aba "Storage" do projeto -> Create Database -> Blob). Sem essa variável,
# o envio de foto em produção falha com uma mensagem pedindo pra configurar.
BLOB_READ_WRITE_TOKEN=
